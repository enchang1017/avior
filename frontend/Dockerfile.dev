FROM node:23-alpine

# corepack reads packageManager from package.json, so the container runs the same
# pnpm as a developer's machine. Without the pin the resolvers diverge silently.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 5173
CMD ["pnpm", "run", "dev"]
