AVIOR_ENV=development
AVIOR_AUTH_MODE=trusted-local
AVIOR_HTTP_ADDR=:8080
AVIOR_SECURE_COOKIES=false
AVIOR_TARGET_LABEL=CDP local
AVIOR_STORE_DSN=postgres://avior_local_store@host.docker.internal:5432/avior?sslmode=disable
AVIOR_TARGET_DSN=postgres://avior_local_reader@host.docker.internal:5432/cdp?sslmode=disable
AVIOR_STORE_PASSWORD=replace-with-local-store-password
AVIOR_TARGET_PASSWORD=replace-with-local-reader-password
AVIOR_SESSION_SECRET=replace-with-output-of-openssl-rand-hex-32
