# Copy to gateway.env, which is gitignored, and fill in. Every value here is a
# placeholder. Secrets are never written in this file: each is a file under
# secrets/gateway/, mounted at /run/secrets/avior, and named with _FILE.
#
# AVIOR_ENV is set by docker-compose.yml, production unless the shell says
# otherwise. The gateway refuses to start on a missing value, the development
# session secret, or self-approval of writes in production.

AVIOR_LOG_LEVEL=info
AVIOR_LOG_FORMAT=json

AVIOR_AUTH_MODE=ldap
AVIOR_LDAP_URL=ldaps://directory.example.com
AVIOR_LDAP_BIND_FORMAT=uid=%s,ou=people,dc=example,dc=com
AVIOR_LDAP_DEFAULT_ROLE=developer

AVIOR_WRITE_APPROVAL=required

# One role per act, each created by deploy/store/bootstrap.sql. No password in
# any DSN: it comes from the matching _FILE below.
AVIOR_STORE_DSN=postgres://avior@db.example.com:5432/aviordb?sslmode=verify-full
AVIOR_TARGET_DSN=postgres://avior_governed@db.example.com:5432/postgres?sslmode=verify-full
AVIOR_WRITE_DSN=postgres://avior_writer@db.example.com:5432/postgres?sslmode=verify-full
AVIOR_DEPLOY_DSN=postgres://avior_deployer@db.example.com:5432/postgres?sslmode=verify-full
AVIOR_PROVISION_DSN=postgres://avior_provisioner@db.example.com:5432/postgres?sslmode=verify-full

AVIOR_SESSION_SECRET_FILE=/run/secrets/avior/session_secret
AVIOR_ADMIN_PASSWORD_FILE=/run/secrets/avior/admin_password
AVIOR_STORE_PASSWORD_FILE=/run/secrets/avior/store_password
AVIOR_TARGET_PASSWORD_FILE=/run/secrets/avior/target_password
AVIOR_WRITE_PASSWORD_FILE=/run/secrets/avior/write_password
AVIOR_DEPLOY_PASSWORD_FILE=/run/secrets/avior/deploy_password
AVIOR_PROVISION_PASSWORD_FILE=/run/secrets/avior/provision_password
