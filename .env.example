# Copied to .env by `make dev`. Local development only — every value here is
# public and must never appear in staging or production.

AVIOR_ENV=development
# Off for a local stack served over http://localhost. Defaults to on, and
# production refuses to start with it off.
AVIOR_SECURE_COOKIES=false
AVIOR_HTTP_ADDR=:8080
# Published on 58080; 8080 is commonly taken on developer machines.
AVIOR_LOG_LEVEL=debug
AVIOR_LOG_FORMAT=text

# trusted-local: any existing account signs in with a username alone. Refused
# outside development. Production will authenticate against LDAP.
AVIOR_AUTH_MODE=trusted-local

# Read only under AVIOR_AUTH_MODE=ldap. What an operator is worth the first time
# the directory vouches for them: FEAT-007 AC-13 makes the account on that first
# sign-in, and this is what it holds. `developer` lets anybody the directory
# holds read a governed database, and keeping somebody out becomes blocking them
# afterwards. Empty makes the account and grants nothing, which leaves them
# visible to an administrator and able to reach nothing. `administrator` is
# refused. See docs/adr/0006.
AVIOR_LDAP_DEFAULT_ROLE=developer

# FEAT-056. Accounts that always work, whatever the directory says. Read once at
# startup; a Kubernetes Secret mounted as a file in a real deployment, which is
# where the passwords live. Empty declares none and leaves the directory as the
# only way in.
#
# They exist for two things nothing else covers: signing in while the directory
# is unreachable, which AVIOR_AUTH_MODE=ldap otherwise refuses everybody for,
# and holding the administrator role, which the account page never grants.
#
# - username: avior_admin
#   password: "..."
#   roles: [administrator]
AVIOR_LOCAL_ACCOUNTS_FILE=

AVIOR_STORE_DSN=postgres://avior:avior@localhost:55432/avior?sslmode=disable
AVIOR_TARGET_DSN=postgres://avior_governed:avior_governed_local@localhost:55432/aviorfixture?sslmode=disable
# The second credential. Applying a migration is a different act by a different
# principal from running a SELECT, so it is a different role: this one may change
# schema, and the one above cannot. FEAT-017.
AVIOR_DEPLOY_DSN=postgres://avior_deployer:avior_deployer_local@localhost:55432/aviordeploy?sslmode=disable

# FEAT-059. The only credential holding CREATEDB and CREATEROLE. It connects to
# the maintenance database, because CREATE DATABASE cannot be issued from inside
# the one it is creating. Unset switches provisioning off.
AVIOR_PROVISION_DSN=postgres://avior_provisioner:avior_provisioner_local@localhost:55432/postgres?sslmode=disable
AVIOR_SESSION_SECRET=local-development-secret-not-for-any-real-environment
AVIOR_MAX_SUBTREE_COST=50
AVIOR_MAX_ESTIMATE_ROWS=1000000


# The frontend dev server proxies /api here, so the browser stays same-origin.
AVIOR_PROXY_TARGET=http://localhost:58080

